---
import { education, achievements } from '../data/education.ts';
---
<section id="education" class="border-t border-hairline/10 py-20">
  <h2 class="font-mono text-sm font-normal text-accent">06 / Education &amp; Recognition</h2>
  <ol class="reveal mt-8 space-y-8">
    <li class="relative pl-6">
      <span class="absolute left-[4px] top-3 -bottom-8 w-px bg-hairline/20"></span>
      <span class="absolute left-0 top-2 h-2.5 w-2.5 rounded-full bg-accent ring-4 ring-canvas"></span>
      <h3 class="text-lg font-semibold text-ink">Education</h3>
      {education.map((e) => (
        <div class="mt-1">
          <p class="text-ink">{e.degree}</p>
          <p class="font-mono text-sm text-muted">{e.org} · {e.period}</p>
        </div>
      ))}
    </li>
    <li class="relative pl-6">
      <span class="absolute left-0 top-2 h-2.5 w-2.5 rounded-full bg-accent ring-4 ring-canvas"></span>
      <div class="flex flex-wrap items-baseline justify-between gap-x-3">
        <h3 class="text-lg font-semibold text-ink">Recognition</h3>
        <span class="font-mono text-xs text-muted">Professional, at Synaptic</span>
      </div>
      <ul class="mt-3 space-y-1.5 text-sm text-muted">
        {achievements.map((a) => (<li class="flex gap-2"><span class="text-accent">▹</span><span>{a}</span></li>))}
      </ul>
    </li>
  </ol>
</section>
